INVOICE_COLLECTOR_BIND_PORT=8080
INVOICE_COLLECTOR_FRONTEND_URL=https://collector.example.internal
INVOICE_COLLECTOR_MONGODB_NAME=invoice_collector

INVOICE_COLLECTOR_OPENBAO_ADDR=https://openbao.example.internal
INVOICE_COLLECTOR_OPENBAO_TOKEN_FILE=./secrets/openbao-token
INVOICE_COLLECTOR_OPENBAO_KV_MOUNT=secret
INVOICE_COLLECTOR_OPENBAO_PREFIX=invoice-collector
INVOICE_COLLECTOR_OPENBAO_NAMESPACE=

# Pre-create this directory as uid/gid 1000 with mode 0700. The first-start
# customer bearer is written once to customer-bearer and never printed in prod.
INVOICE_COLLECTOR_RUNTIME_DIR=./runtime
